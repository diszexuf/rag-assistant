# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- База данных (хост db — имя сервиса в docker-compose) ---
DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag

# --- LLM ---
# mock — заглушка без обращения к сети; gigachat — живой API
LLM_PROVIDER=mock

# Ключ авторизации GigaChat (Authorization key из личного кабинета, строка Base64)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_EMBEDDING_MODEL=Embeddings
# Проверка TLS-сертификата. Нужен корневой сертификат Минцифры (Russian Trusted Root CA).
# Положите его в backend/certs/ и укажите путь относительно папки backend,
# либо отключите проверку (только для отладки).
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem

# Источник эмбеддингов: mock — локальные, на хешах слов; gigachat — API
# (у GigaChat эмбеддинги оплачиваются отдельно от чата).
# tei — BAAI/bge-m3 в контейнере embeddings (docker compose up -d embeddings; первый запуск
# скачивает модель ~2.3 ГБ). После смены источника загрузите базу знаний заново:
# python -m seed.seed --reset — и подберите порог поиска (python -m eval.run_search).
EMBEDDING_PROVIDER=mock
EMBEDDINGS_URL=http://embeddings:80

# Размерность векторов. Должна совпадать с моделью эмбеддингов;
# после смены модели базу знаний нужно переиндексировать.
EMBEDDING_DIM=1024

# --- Поиск ---
# Максимальное косинусное расстояние, при котором операция считается релевантной.
# 0.5 подобран под заглушку (хеши слов). У bge-m3 расстояния другие: на eval-наборе
# 0.35 не теряет верных операций (см. docs/EVAL.md); уточняйте по python -m eval.run_search.
# С реранкером этот порог не используется, действует RERANK_MIN_SCORE.
SEARCH_MAX_DISTANCE=0.5
SEARCH_TOP_K=3

# Реранкер: none — без него; tei — BAAI/bge-reranker-v2-m3 в контейнере reranker
# (docker compose up -d reranker). Среди SEARCH_CANDIDATES ближайших операций он выбирает
# лучшие; релевантность определяет RERANK_MIN_SCORE (0..1), SEARCH_MAX_DISTANCE тогда не нужен.
# Значение подберите: python -m eval.run_search --rerank (RERANK_MIN_SCORE = 1 - порог).
RERANKER_PROVIDER=none
RERANKER_URL=http://reranker:80
SEARCH_CANDIDATES=20
RERANK_MIN_SCORE=0.3

# --- Генерация ---
MAX_FIX_ATTEMPTS=3
LLM_TIMEOUT_S=90
# Общий таймаут запуска на сервере; должен быть меньше клиентского
RUN_TIMEOUT_S=280

# --- Логи ---
# INFO — ход работы по каждому запросу (поиск, вызовы модели, проверка, исправления, итог);
# DEBUG — дополнительно полные тексты запросов к модели и её ответов; WARNING — только проблемы.
LOG_LEVEL=INFO

# --- Клиент ---
VITE_RUN_TIMEOUT_S=300
